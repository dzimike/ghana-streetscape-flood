# Google Maps Platform
GOOGLE_MAPS_API_KEY=your_key_here

# Google Earth Engine (service account or user auth)
GEE_PROJECT=your-gee-project-id
GEE_SERVICE_ACCOUNT=your-service-account@project.iam.gserviceaccount.com
GEE_KEY_FILE=configs/gee_key.json

# MLflow tracking
MLFLOW_TRACKING_URI=mlruns

# Weights & Biases (optional)
WANDB_API_KEY=
WANDB_PROJECT=streetscape-flood

# Paths (override defaults from config if needed)
DATA_DIR=data
MODELS_DIR=models
OUTPUTS_DIR=outputs
